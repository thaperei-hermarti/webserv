#!/usr/bin/env bash
# Pre-commit hook: clang-format check on staged C++ files + quick build.
set -uo pipefail

ROOT_DIR="$(git rev-parse --show-toplevel)"
cd "$ROOT_DIR"

STAGED_FILES="$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(cpp|cc|cxx|hpp|h|hh)$' || true)"

if [ -n "$STAGED_FILES" ]; then
	if ! command -v clang-format >/dev/null 2>&1; then
		echo "[ERROR] clang-format not found. Install it or run 'make setup'."
		exit 1
	fi
	if ! echo "$STAGED_FILES" | xargs clang-format --dry-run -Werror; then
		echo ""
		echo "[FAIL] Formatting issues in staged files."
		echo "       Fix them with:  make format"
		echo "       Then re-stage:   git add <files>"
		exit 1
	fi
	echo "[OK] Staged files are properly formatted"
fi

if [ -n "$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(cpp|cc|cxx|hpp|h|hh|mk)$' || true)" ]; then
	if ! command -v clang-tidy >/dev/null 2>&1; then
		echo "[WARNING] clang-tidy not found, skipping lint"
	else
		if ! make -s lint; then
			echo ""
			echo "[FAIL] clang-tidy found issues."
			exit 1
		fi
	fi
fi

if [ -n "$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(cpp|cc|cxx|hpp|h|hh|mk)$' || true)" ]; then
	if ! make -s re >/dev/null 2>&1; then
		echo "[FAIL] Project does not compile."
		exit 1
	fi
	echo "[OK] Project compiles"
fi

exit 0
