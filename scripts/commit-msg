#!/usr/bin/env bash
# commit-msg hook: enforce Conventional Commits.
# https://www.conventionalcommits.org
set -uo pipefail

MSG_FILE="$1"

SUBJECT="$(grep -v '^#' "$MSG_FILE" | sed '/^$/d' | head -1)"

case "$SUBJECT" in
	Merge*) exit 0 ;;   # merge commits are generated by git/gh, not authored
	Revert*) exit 0 ;;  # git revert generates "Revert \"...\"" messages
esac

PATTERN='^(build|chore|ci|docs|feat|fix|perf|refactor|revert|style|test|raw|wip)(\([a-z0-9._/-]+\))?(!)?: .+$'

if ! printf '%s' "$SUBJECT" | grep -qE "$PATTERN"; then
	echo ""
	echo "[FAIL] Commit message is not a Conventional Commit"
	echo ""
	echo "Format:  <type>(<scope>): <description>"
	echo "Examples:"
	echo "  feat(parser): handle chunked request bodies"
	echo "  fix(cgi): reap zombie children without blocking the loop"
	echo "  chore: add commit-msg hook"
	echo ""
	echo "Types: build, chore, ci, docs, feat, fix, perf, refactor, revert, style, test, raw, wip"
	echo "Breaking change: add ! before the colon (feat!: ...) or a BREAKING CHANGE footer."
	echo ""
	exit 1
fi

exit 0
